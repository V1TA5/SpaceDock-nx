
// ==========================================
// SPACEDOCK - GRAFANA ALLOY
// Grafana Alloy v1.22.0
// Shared development / production observability
// ==========================================


// ==========================================
// PROMETHEUS METRICS -> MIMIR
// ==========================================

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}


// ==========================================
// INFRASTRUCTURE METRICS
// ==========================================

prometheus.scrape "infrastructure" {
  targets = [
    {
      __address__ = "postgres-exporter:9187",
      job         = "postgres",
    },
    {
      __address__ = "redis-exporter:9121",
      job         = "redis",
    },
    {
      __address__ = "node-exporter:9100",
      job         = "node",
    },
    {
      __address__ = "cadvisor:8080",
      job         = "cadvisor",
    },
    {
      __address__ = "beyla:8999",
      job         = "beyla",
    },
  ]

  scrape_interval = "15s"

  forward_to = [
    prometheus.remote_write.mimir.receiver,
  ]
}


// ==========================================
// ALLOY SELF MONITORING
// ==========================================

prometheus.scrape "alloy" {
  targets = [
    {
      __address__ = "127.0.0.1:12345",
      job         = "alloy",
    },
  ]

  scrape_interval = "15s"

  forward_to = [
    prometheus.remote_write.mimir.receiver,
  ]
}


// ==========================================
// OTLP RECEIVER
// BACKEND METRICS AND TRACES
// ==========================================

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [
      otelcol.processor.batch.metrics.input,
    ]

    traces = [
      otelcol.processor.batch.traces.input,
    ]
  }
}


// ==========================================
// METRICS PROCESSING
// ==========================================

otelcol.processor.batch "metrics" {
  timeout = "5s"

  send_batch_size = 1024

  output {
    metrics = [
      otelcol.exporter.prometheus.default.input,
    ]
  }
}


// ==========================================
// TRACE PROCESSING
// ==========================================

otelcol.processor.batch "traces" {
  timeout = "5s"

  send_batch_size = 1024

  output {
    traces = [
      otelcol.exporter.otlp.tempo.input,
    ]
  }
}


// ==========================================
// OTLP METRICS -> MIMIR
// ==========================================

otelcol.exporter.prometheus "default" {
  forward_to = [
    prometheus.remote_write.mimir.receiver,
  ]
}


// ==========================================
// OTLP TRACES -> TEMPO
// ==========================================

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}


// ==========================================
// FARO FRONTEND TELEMETRY
// ==========================================

faro.receiver "frontend" {
  server {
    listen_address = "0.0.0.0"
    listen_port   = 12347

    cors_allowed_origins = [
      "http://localhost:5080",
      "https://localhost:5443",
      "http://localhost:5173",
    ]
  }

  extra_log_labels = {
    service_name = "spacedock.frontend",
    environment  = "development",
  }

  output {
    logs = [
      loki.write.default.receiver,
    ]

    traces = [
      otelcol.processor.batch.traces.input,
    ]
  }
}


// ==========================================
// DOCKER CONTAINER DISCOVERY
// ==========================================

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}


// ==========================================
// DOCKER CONTAINER LOGS -> LOKI
// ==========================================

loki.source.docker "containers" {
  host = "unix:///var/run/docker.sock"

  targets = discovery.docker.containers.targets

  forward_to = [
    loki.write.default.receiver,
  ]
}


// ==========================================
// LOKI LOG STORAGE
// ==========================================

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
