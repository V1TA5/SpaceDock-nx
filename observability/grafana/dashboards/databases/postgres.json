
{
  "uid": "spacedock-postgres",
  "title": "SpaceDock - PostgreSQL",
  "tags": [
    "spacedock",
    "postgresql",
    "database"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Active Connections",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "pg_stat_activity_count{state=\"active\"}",
          "legendFormat": "Active",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Idle Connections",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "pg_stat_activity_count{state=\"idle\"}",
          "legendFormat": "Idle",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Database Size",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"spacedock\"}",
          "legendFormat": "SpaceDock",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total Connections",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count)",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Connections by State",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Transaction Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"spacedock\"}[5m]))",
          "legendFormat": "Commits/sec",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"spacedock\"}[5m]))",
          "legendFormat": "Rollbacks/sec",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Cache Hit Ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * sum(rate(pg_stat_database_blks_hit{datname=\"spacedock\"}[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=\"spacedock\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"spacedock\"}[5m])), 1)",
          "legendFormat": "Cache Hit Ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Deadlocks",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "expr": "increase(pg_stat_database_deadlocks{datname=\"spacedock\"}[5m])",
          "legendFormat": "Deadlocks",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Rows Inserted",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_tup_inserted{datname=\"spacedock\"}[5m]))",
          "legendFormat": "Inserted/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Rows Updated and Deleted",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_tup_updated{datname=\"spacedock\"}[5m]))",
          "legendFormat": "Updated/sec",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pg_stat_database_tup_deleted{datname=\"spacedock\"}[5m]))",
          "legendFormat": "Deleted/sec",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "title": "Connection Usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * sum(pg_stat_activity_count) / pg_settings_max_connections",
          "legendFormat": "Connection Usage",
          "refId": "A"
        }
      ]
    }
  ]
}
