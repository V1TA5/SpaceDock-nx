
{
  "uid": "spacedock-overview",
  "title": "SpaceDock Overview",
  "tags": ["spacedock", "application"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
