
{
  "uid": "spacedock-database",
  "title": "SpaceDock - PostgreSQL Database",
  "tags": [
    "spacedock",
    "postgresql",
    "database",
    "postgres-exporter"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "PostgreSQL Exporter Availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"postgres\"}",
          "legendFormat": "Exporter",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Database Availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_up",
          "legendFormat": "PostgreSQL",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active Connections",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count{datname=\"spacedock\"})",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Database Size",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"spacedock\"}",
          "legendFormat": "Database",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Connection States",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum by (state) (pg_stat_activity_count{datname=\"spacedock\"})",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Connection Utilization",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * sum(pg_stat_activity_count{datname=\"spacedock\"}) / clamp_min(max(pg_settings_max_connections), 1)",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Transactions Per Second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"spacedock\"}[5m])) + sum(rate(pg_stat_database_xact_rollback{datname=\"spacedock\"}[5m]))",
          "legendFormat": "Transactions/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Commits and Rollbacks",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"spacedock\"}[5m])",
          "legendFormat": "Commits/sec",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"spacedock\"}[5m])",
          "legendFormat": "Rollbacks/sec",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "Database Cache Hit Ratio",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * sum(pg_stat_database_blks_hit{datname=\"spacedock\"}) / clamp_min(sum(pg_stat_database_blks_hit{datname=\"spacedock\"}) + sum(pg_stat_database_blks_read{datname=\"spacedock\"}), 1)",
          "legendFormat": "Cache Hit Ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Deadlocks",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_deadlocks{datname=\"spacedock\"}[5m])",
          "legendFormat": "Deadlocks/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Database Block Reads",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_blks_read{datname=\"spacedock\"}[5m])",
          "legendFormat": "Blocks read/sec",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_blks_hit{datname=\"spacedock\"}[5m])",
          "legendFormat": "Blocks hit/sec",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "title": "Database Temporary Files",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_temp_files{datname=\"spacedock\"}[5m])",
          "legendFormat": "Temporary files/sec",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_temp_bytes{datname=\"spacedock\"}[5m])",
          "legendFormat": "Temporary bytes/sec",
          "refId": "B"
        }
      ]
    },
    {
      "id": 13,
      "title": "Database Lock Count",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "expr": "sum by (mode) (pg_locks_count{datname=\"spacedock\"})",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    }
  ]
}
