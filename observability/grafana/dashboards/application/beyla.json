
{
  "uid": "spacedock-beyla",
  "title": "SpaceDock - Beyla eBPF",
  "tags": [
    "spacedock",
    "beyla",
    "ebpf",
    "application"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests Per Second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"beyla\"}[5m]))",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Error Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"beyla\",http_response_status_code=~\"4..|5..\"}[5m]))",
          "legendFormat": "Errors/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Request Latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"beyla\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"beyla\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"beyla\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP Status Codes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"beyla\"}[5m]))",
          "legendFormat": "{{http_response_status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Methods",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (http_request_method) (rate(http_server_request_duration_seconds_count{job=\"beyla\"}[5m]))",
          "legendFormat": "{{http_request_method}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Slow Requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"beyla\"}[5m]))",
          "legendFormat": "Total requests/sec",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Beyla Exporter Health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "up{job=\"beyla\"}",
          "legendFormat": "Beyla",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Observed Services",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "count(count by (service_name) ({job=\"beyla\"}))",
          "legendFormat": "Services",
          "refId": "A"
        }
      ]
    }
  ]
}
