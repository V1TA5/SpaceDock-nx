
{
  "uid": "spacedock-frontend",
  "title": "SpaceDock - Frontend",
  "tags": [
    "spacedock",
    "frontend",
    "faro",
    "browser",
    "application"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Frontend Telemetry",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"spacedock.frontend\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Frontend Error Events",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"spacedock.frontend\"} |~ \"(?i)(error|exception|uncaught)\" [1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Frontend Events Per Minute",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate({service_name=\"spacedock.frontend\"}[5m])) * 60",
          "legendFormat": "Events/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Frontend Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "{service_name=\"spacedock.frontend\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 5,
      "title": "Frontend Error Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "expr": "{service_name=\"spacedock.frontend\"} |~ \"(?i)(error|exception|uncaught)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 6,
      "title": "Frontend Trace Volume",
      "type": "timeseries",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"spacedock.frontend\" }",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Frontend Trace Errors",
      "type": "timeseries",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"spacedock.frontend\" && status = error }",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Frontend Trace Search",
      "type": "traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"spacedock.frontend\" }",
          "refId": "A"
        }
      ]
    }
  ]
}
